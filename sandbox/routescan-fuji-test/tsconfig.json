/* Based on https://github.com/tsconfig/bases/blob/501da2bcd640cf95c95805783e1012b992338f28/bases/node22.json */
{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "node",
      "hardhat"
    ],
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowJs": true,
    "isolatedModules": true
  },
  "include": [
    "hardhat.config.ts",
    "contracts",
    "scripts",
    "test",
    "ignition",
    "hardhat.env.d.ts"
  ]
}


